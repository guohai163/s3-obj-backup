# Generate an admin password with: openssl rand -hex 24
ADMIN_USER=admin
ADMIN_PASSWORD=
VIEWER_USER=
VIEWER_PASSWORD=

# Keep this 32-byte key and the database backup together. Generate once.
# openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Generate with openssl rand -hex 24 for the bundled database.
POSTGRES_PASSWORD=
# External database only. Percent-encode URL components as needed.
# DATABASE_URL=postgresql://user:password@postgres.example.com:5432/s3backup?sslmode=verify-full

APP_BIND=127.0.0.1
APP_PORT=8080
# Enable for deployments accessed over HTTPS.
COOKIE_SECURE=false
# APP_IMAGE=ghcr.io/guohai163/s3-obj-backup:v0.1.0
